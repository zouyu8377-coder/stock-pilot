# LLM API 配置（兼容 OpenAI API 格式）
# 示例：火山方舟、OneAPI、OpenRouter 等
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_API_KEY=your-api-key-here
LLM_MODEL=kimi-k2.6

# Daily Agent review. Keep the completion budget bounded but large enough for
# per-action daily reflection plus five-trading-day symbol aggregation.
AGENT_REVIEW_MODEL=deepseek-v4-pro
AGENT_REVIEW_MAX_TOKENS=12000
AGENT_REVIEW_THINKING=disabled
AGENT_REVIEW_TIMEOUT_SECONDS=360
AGENT_REVIEW_REQUEST_TIMEOUT_SECONDS=540

# Tushare backend-only token. Do not expose this via VITE_ variables.
TUSHARE_TOKEN=your-tushare-token-here
TUSHARE_RATE_LIMIT_SECONDS=0
TUSHARE_CACHE_ROOT=data/tushare
ANALYSIS_SNAPSHOT_DIR=data/analysis_snapshots
PORTFOLIO_DATA_DIR=data/portfolio
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

# Portfolio screenshot parsing. Keep real values only in local .env.
PORTFOLIO_VISION_PROVIDER=local_noop
VOLCENGINE_ARK_VISION_ENABLED=false
VOLCENGINE_ARK_VISION_BASE_URL=
VOLCENGINE_ARK_VISION_API_KEY=
VOLCENGINE_ARK_VISION_MODEL=minimax-m3
VOLCENGINE_ARK_VISION_TIMEOUT=120
VOLCENGINE_ARK_VISION_MAX_TOKENS=4096
VOLCENGINE_ARK_VISION_RETRY_MAX_TOKENS=8192
VOLCENGINE_ARK_VISION_SEGMENT_MAX_TOKENS=4096
VOLCENGINE_ARK_VISION_THINKING_MODE=disabled
VOLCENGINE_ARK_VISION_JSON_MODE=true

# Public announcement full-text verification. Uses CNINFO PDFs and the configured LLM.
DISCLOSURE_VERIFICATION_ENABLED=true
DISCLOSURE_VERIFICATION_MAX_SYMBOLS=8
DISCLOSURE_VERIFICATION_MAX_DOCUMENTS=2
DISCLOSURE_VERIFICATION_CACHE_DAYS=7
DISCLOSURE_INDEX_CHECK_MINUTES=60

# Reuse the assembled dashboard between page visits. Manual refresh bypasses it.
DASHBOARD_CACHE_SECONDS=300

# Model-free startup collection; independent of legacy LLM automation.
STOCK_PILOT_AUTO_DATA_SYNC=1
